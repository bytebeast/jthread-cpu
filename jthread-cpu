def _hex_rgb(h):
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def _rgb_256(r, g, b):
    """Nearest xterm-256 index, for terminals without truecolor."""
    if abs(r - g) < 11 and abs(g - b) < 11:  # greyscale ramp
        if r < 8:
            return 16
        if r > 248:
            return 231
        return 232 + int(round((r - 8) / 247.0 * 24))
    q = lambda v: 0 if v < 48 else (1 if v < 115 else min(5, (v - 35) // 40))
    return 16 + 36 * q(r) + 6 * q(g) + q(b)


def _supports_truecolor():
    if os.environ.get("COLORTERM", "").lower() in ("truecolor", "24bit"):
        return True
    return os.environ.get("TERM", "").endswith(("direct", "truecolor"))


class C:
    """Catppuccin palette. Every attribute becomes '' when colour is off."""

    RESET = "\033[0m"
    BOLD = "\033[1m"
    # semantic slots, filled in by apply_theme()
    TEXT = DIM = GREY = RED = MAROON = PEACH = YELLOW = GREEN = ""
    TEAL = SKY = BLUE = LAVENDER = MAUVE = PINK = ""
    CYAN = MAGENTA = BG_RED = HEADER = ""
    theme = "mocha"

    @classmethod
    def apply_theme(cls, name):
        if name == "auto":
            # COLORFGBG ends with a high number on light backgrounds
            bg = os.environ.get("COLORFGBG", "").split(";")[-1]
            name = "latte" if bg.isdigit() and int(bg) >= 7 else "mocha"
        pal = CATPPUCCIN.get(name, CATPPUCCIN["mocha"])
        cls.theme = name
        true = _supports_truecolor()

        def fg(key):
            r, g, b = _hex_rgb(pal[key])
            return (
                "\033[38;2;%d;%d;%dm" % (r, g, b)
                if true
                else "\033[38;5;%dm" % _rgb_256(r, g, b)
            )

        def bg_on(bgkey, fgkey):
            r, g, b = _hex_rgb(pal[bgkey])
            fr, fgc, fb = _hex_rgb(pal[fgkey])
            if true:
                return "\033[48;2;%d;%d;%dm\033[38;2;%d;%d;%dm" % (r, g, b, fr, fgc, fb)
            return "\033[48;5;%dm\033[38;5;%dm" % (
                _rgb_256(r, g, b),
                _rgb_256(fr, fgc, fb),
            )

        cls.TEXT = fg("text")
        cls.DIM = fg("overlay1")
        cls.GREY = fg("overlay0")
        cls.RED = fg("red")
        cls.MAROON = fg("maroon")
        cls.PEACH = fg("peach")
        cls.YELLOW = fg("yellow")
        cls.GREEN = fg("green")
        cls.TEAL = fg("teal")
        cls.SKY = fg("sky")
        cls.BLUE = fg("blue")
        cls.LAVENDER = fg("lavender")
        cls.MAUVE = fg("mauve")
        cls.PINK = fg("pink")
        cls.CYAN = cls.SKY  # legacy aliases
        cls.MAGENTA = cls.MAUVE
        cls.HEADER = fg("mauve")
        cls.BG_RED = bg_on("red", "crust")

    @classmethod
    def disable(cls):
        for name in dir(cls):
            if name.isupper():
                setattr(cls, name, "")


class G:
    """Box-drawing glyphs, with an ASCII fallback for LANG=C terminals."""

    BAR = "█"  # full block
    EMPTY = "·"  # middle dot
    ARROW = "↳"  # downwards arrow with tip rightwards
    WAIT = "⊘"  # circled division slash
    ELLIPSIS = "…"
    HINT = "→"  # rightwards arrow
    SPARK = "▁▂▃▄▅▆▇█"  # one glyph per eighth of a core
    GAP = "·"  # sparkline slot where the thread did not exist
    TIMES = "×"

    @classmethod
    def to_ascii(cls):
        cls.BAR, cls.EMPTY, cls.ARROW, cls.WAIT, cls.ELLIPSIS = (
            "#",
            ".",
            "->",
            "!",
            "...",
        )
        cls.HINT, cls.SPARK, cls.GAP, cls.TIMES = ">", "_.-=+*%#", " ", "x"


def setup_encoding(force_ascii=False):
    """Never let an unencodable glyph abort the report half-written."""
    enc = getattr(sys.stdout, "encoding", None) or "ascii"
    try:
        (
            G.BAR + G.EMPTY + G.ARROW + G.WAIT + G.ELLIPSIS + G.HINT + G.SPARK + G.TIMES
        ).encode(enc)
        unicode_ok = True
    except (UnicodeEncodeError, LookupError):
        unicode_ok = False
    if force_ascii or not unicode_ok:
        G.to_ascii()
    # thread names and frames can still hold non-ASCII, so degrade rather than raise
    if not unicode_ok:
        try:
            sys.stdout.reconfigure(errors="replace")  # py3.7+
        except AttributeError:
            try:
                sys.stdout = io.TextIOWrapper(
                    sys.stdout.buffer,
                    encoding=enc,
                    errors="replace",
                    line_buffering=True,
                )
            except Exception:
                pass
        except Exception:
            pass


def term_width(default=100):
    try:
        return max(80, min(shutil.get_terminal_size((default, 24)).columns, 200))
    except Exception:
        return default


def die(msg, code=1):
    sys.stderr.write("%serror:%s %s\n" % (C.RED + C.BOLD, C.RESET, msg))
    sys.exit(code)


def warn(msg):
    sys.stderr.write("%swarning:%s %s\n" % (C.YELLOW, C.RESET, msg))


def run(cmd, timeout=60, check=False):
    """Run a command, return (rc, stdout, stderr).

    Forced into the C locale: a translated `top` header would break parsing.
    """
    env = dict(os.environ, LC_ALL="C", LANG="C")
    try:
        p = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            text=True,
            env=env,
        )
    except FileNotFoundError:
        return 127, "", "%s: not found" % cmd[0]
    except subprocess.TimeoutExpired:
        return 124, "", "%s: timed out after %ss" % (cmd[0], timeout)
    if check and p.returncode != 0:
        die("%s failed (rc=%d): %s" % (" ".join(cmd), p.returncode, p.stderr.strip()))
    return p.returncode, p.stdout, p.stderr


