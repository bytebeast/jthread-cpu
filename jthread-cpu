def _strip_launcher_noise(text):
    """Drop the `Picked up JAVA_TOOL_OPTIONS: ...` banners the launcher emits."""
    if "Picked up " not in text:
        return text
    return "\n".join(
        l
        for l in text.splitlines()
        if not l.startswith(
            (
                "Picked up JAVA_TOOL_OPTIONS",
                "Picked up _JAVA_OPTIONS",
                "Picked up JDK_JAVA_OPTIONS",
                "OpenJDK 64-Bit Server VM warning",
            )
        )
    )


def _tidy_error(text):
    """Keep the last few meaningful lines of a tool's complaint."""
    lines = [l.strip() for l in _strip_launcher_noise(text).splitlines() if l.strip()]
    return "\n  ".join(lines[-3:]) if lines else ""


def capture_jstack(pid, force=False, tool=None):
    """Grab a thread dump. Try jcmd first (no -F needed), then jstack."""
    attempts = []
    if tool:
        if "jcmd" in os.path.basename(tool):
            attempts.append([tool, str(pid), "Thread.print", "-l"])
        else:
            attempts.append([tool, "-l", str(pid)])
            if force:
                attempts.append([tool, "-F", "-l", str(pid)])
    else:
        if shutil.which("jcmd"):
            attempts.append(["jcmd", str(pid), "Thread.print", "-l"])
        if shutil.which("jstack"):
            attempts.append(["jstack", "-l", str(pid)])
            if force:
                attempts.append(["jstack", "-F", "-l", str(pid)])

    if not attempts:
        die(
            "neither jcmd nor jstack found on PATH.\n"
            "  Debian/Ubuntu: apt install openjdk-17-jdk-headless\n"
            "  macOS:         they ship with the JDK (not the JRE)"
        )

    last_err = ""
    for cmd in attempts:
        rc, out, err = run(cmd, timeout=120)
        out = _strip_launcher_noise(out)
        if rc == 0 and ("nid=" in out or "java.lang.Thread.State" in out):
            return out
        last_err = _tidy_error(err or out)

    hint = ""
    low = last_err.lower()
    if "well-known file is not secure" in low or "operation not permitted" in low:
        hint = (
            "\n  hint: run as the same user that owns the JVM, e.g.\n"
            "        sudo -u $(ps -o user= -p %d) %s %d Thread.print"
            % (pid, shutil.which("jcmd") or "jcmd", pid)
        )
    elif "unable to open socket file" in low:
        hint = (
            "\n  hint: not a JVM, or the JVM is busy in GC, or it was started with\n"
            "        -XX:+DisableAttachMechanism.  For a wedged JVM try --force"
        )
    die(
        "could not take a thread dump of pid %d: %s%s"
        % (pid, last_err or "unknown error", hint)
    )


# jstack header line, all JDK versions:
#   "main" #1 prio=5 os_prio=0 tid=0x... nid=0x3039 runnable [0x...]          (8)
#   "main" #1 prio=5 os_prio=0 cpu=68.75ms elapsed=3.44s tid=0x... nid=0x...  (11+)
#   "main" #1 [12345] prio=5 os_prio=0 cpu=68.75ms ... nid=0x3039 waiting...  (21+)
#   "GC Thread#0" os_prio=0 cpu=5.00ms elapsed=3.44s tid=0x... nid=0x3042 runnable
HEADER_RE = re.compile(r'^"(?P<name>.*)"\s+(?P<rest>.*?)\s*$')
NID_RE = re.compile(r"\bnid=(?P<nid>0[xX][0-9a-fA-F]+|-?\d+)")
TID_RE = re.compile(r"\btid=(?P<tid>0[xX][0-9a-fA-F]+|\d+)")
CPU_RE = re.compile(r"\bcpu=(?P<cpu>[\d.]+)ms")
ELAPSED_RE = re.compile(r"\belapsed=(?P<e>[\d.]+)s")
NUM_RE = re.compile(r"^#(?P<n>\d+)\b")
OSTID_RE = re.compile(r"\[(?P<t>\d+)\]")
PRIO_RE = re.compile(r"\bprio=(?P<p>\d+)")
OSPRIO_RE = re.compile(r"\bos_prio=(?P<p>-?\d+)")
STATE_RE = re.compile(
    r"^\s*java\.lang\.Thread\.State:\s*(?P<state>[A-Z_]+)(?P<detail>.*)$"
)
# trailing os-level state, e.g. '... nid=0x3039 waiting on condition  [0x00007f..]'
OSSTATE_RE = re.compile(
    r"\bnid=(?:0[xX][0-9a-fA-F]+|-?\d+)\s+(?P<s>[a-zA-Z][^\[]*?)\s*(?:\[0[xX][0-9a-fA-F]+\])?\s*$"
)


JDK_FRAME_PREFIXES = ("java.", "javax.", "jdk.", "sun.", "com.sun.", "<")


class JThread:
    __slots__ = (
        "cpu_ms",
        "daemon",
        "elapsed_s",
        "frames",
        "header",
        "jnum",
        "locks_held",
        "name",
        "nid",
        "nid_hex",
        "nid_raw",
        "os_prio",
        "os_state",
        "prio",
        "state",
        "state_detail",
        "tid",
        "waiting_on",
    )

    def __init__(self):
        self.name = "?"
        self.jnum = None
        self.daemon = False
        self.prio = None
        self.os_prio = None
        self.nid = None  # decimal native id == Linux TID
        self.nid_hex = None
        self.nid_raw = None  # exactly as the dump printed it (grep-able)
        self.tid = None
        self.cpu_ms = None
        self.elapsed_s = None
        self.state = None  # java.lang.Thread.State
        self.state_detail = ""
        self.os_state = ""
        self.frames = []
        self.locks_held = []
        self.waiting_on = []
        self.header = ""

    @property
    def is_jvm_internal(self):
        """VM threads (GC, JIT, VM Periodic, ...) have no java.lang.Thread.State."""
        return self.state is None

    def top_frame(self):
        for f in self.frames:
            if f.startswith("at "):
                return f[3:]
        return ""

    def java_frames(self):
        return [f[3:] for f in self.frames if f.startswith("at ")]

    def app_frame(self):
        """First frame outside the JDK: usually the line worth opening."""
        for f in self.java_frames():
            if not f.startswith(JDK_FRAME_PREFIXES):
                return f
        return ""

    def to_dict(self):
        return {
            "name": self.name,
            "java_thread_number": self.jnum,
            "daemon": self.daemon,
            "priority": self.prio,
            "os_priority": self.os_prio,
            "os_tid": self.nid,  # kernel TID: the table's TID column
            "nid": self.nid,  # same value, jstack's name for it
            "nid_hex": self.nid_hex,
            "nid_as_printed": self.nid_raw,
            "jvm_tid": self.tid,  # JavaThread pointer from the dump
            "cumulative_cpu_ms": self.cpu_ms,
            "elapsed_s": self.elapsed_s,
            "state": self.state or "JVM_INTERNAL",
            "state_detail": self.state_detail.strip(),
            "os_state": self.os_state,
            "jvm_internal": self.is_jvm_internal,
            "top_frame": self.top_frame(),
            "app_frame": self.app_frame(),
            "stack": self.frames,
            "locks_held": self.locks_held,
            "waiting_on": self.waiting_on,
        }


def parse_jstack(text):
    """Return (threads, meta) from a thread dump."""
    threads = []
    meta = {
        "deadlocks": [],
        "header": "",
        "jvm_version": "",
        "timestamp": "",
        "pid": None,
    }

    lines = text.splitlines()

    for line in lines[:3]:
        m_pid = re.match(r"^(\d+):\s*$", line.strip())
        if m_pid:
            meta["pid"] = int(m_pid.group(1))
            break

    for line in lines[:6]:
        line = line.strip()
        if re.match(r"^\d{4}-\d\d-\d\d \d\d:\d\d:\d\d", line):
            meta["timestamp"] = line
        elif (
            "JVM" in line
            or ("VM" in line and "mixed mode" in line)
            or "OpenJDK" in line
            or "HotSpot" in line
            or "Java HotSpot" in line
        ):
            meta["jvm_version"] = line

    # deadlock blocks: the summary half (who waits on whom), not the repeated stacks
    for m_dl in re.finditer(r"^Found one Java-level deadlock:.*?$", text, re.M):
        tail = text[m_dl.start() :]
        end = re.search(
            r"^(?:Java stack information for the threads listed above:|Found \d+ deadlock)",
            tail,
            re.M,
        )
        meta["deadlocks"].append((tail[: end.start()] if end else tail[:4000]).strip())
    meta["deadlock_detail"] = "\n".join(
        re.findall(
            r"^Java stack information for the threads listed above:.*?(?=^Found \d+ deadlock)",
            text,
            re.S | re.M,
        )
    )

    cur = None
    in_ownable = False
    for raw in lines:
        line = raw.rstrip("\n")

        # Everything after these markers is trailer, not thread blocks. Without
        # this the deadlock section's stacks get glued onto the last thread.
        if re.match(
            r"^(JNI global refs:|Found one Java-level deadlock:|"
            r"Java stack information for the threads listed above:|"
            r"Found \d+ deadlock)",
            line,
        ):
            cur = None
            continue
        # deadlock section labels look like  "deadlock-alpha":
        if cur is not None and re.match(r'^".*":\s*$', line):
            cur = None
            continue

        m = HEADER_RE.match(line)
        if m and ("nid=" in line or "tid=" in line or " prio=" in line):
            in_ownable = False
            cur = JThread()
            threads.append(cur)
            cur.header = line.strip()
            cur.name = m.group("name")
            rest = m.group("rest")

            cur.daemon = bool(re.search(r"\bdaemon\b", rest))
            mm = NUM_RE.match(rest)
            if mm:
                cur.jnum = int(mm.group("n"))
            mm = OSTID_RE.search(rest)
            if mm:
                # JDK21+ prints the decimal native tid in brackets
                cur.nid = int(mm.group("t"))
            mm = PRIO_RE.search(rest)
            if mm:
                cur.prio = int(mm.group("p"))
            mm = OSPRIO_RE.search(rest)
            if mm:
                cur.os_prio = int(mm.group("p"))
            mm = CPU_RE.search(rest)
            if mm:
                cur.cpu_ms = float(mm.group("cpu"))
            mm = ELAPSED_RE.search(rest)
            if mm:
                cur.elapsed_s = float(mm.group("e"))
            mm = TID_RE.search(rest)
            if mm:
                cur.tid = mm.group("tid")
            mm = NID_RE.search(rest)
            if mm:
                # Most JDKs print nid in hex (nid=0x3039); some recent builds
                # print it in decimal (nid=12345).  Keep both spellings.
                raw_nid = mm.group("nid")
                cur.nid_raw = raw_nid
                try:
                    cur.nid = (
                        int(raw_nid, 16)
                        if raw_nid.lower().startswith("0x")
                        else int(raw_nid)
                    )
                except ValueError:
                    cur.nid = None
                if cur.nid is not None:
                    cur.nid_hex = (
                        raw_nid if raw_nid.lower().startswith("0x") else hex(cur.nid)
                    )
            if cur.nid is not None and not cur.nid_hex:
                cur.nid_hex = hex(cur.nid)
            if cur.nid is not None and not cur.nid_raw:
                cur.nid_raw = str(cur.nid)
            mm = OSSTATE_RE.search(rest)
            if mm:
                cur.os_state = mm.group("s").strip()
            continue

        if cur is None:
            continue

        m = STATE_RE.match(line)
        if m:
            cur.state = m.group("state")
            cur.state_detail = m.group("detail") or ""
            continue

        s = line.strip()
        if s == "Locked ownable synchronizers:":
            in_ownable = True  # `jstack -l`: j.u.c locks this thread owns
            continue
        if s == "- None":
            continue
        if in_ownable and s.startswith("- <"):
            cur.locks_held.append(s[2:].strip())
            continue
        if s.startswith("at "):
            cur.frames.append(s)
        elif s.startswith("- "):
            cur.frames.append(s)
            if s.startswith("- locked"):
                cur.locks_held.append(s[2:].strip())
            elif (
                s.startswith("- waiting to lock")
                or s.startswith("- parking to wait")
                or s.startswith("- waiting on")
            ):
                cur.waiting_on.append(s[2:].strip())
        elif not s:
            # blank line ends a thread block, but keep `cur` for trailing locks
            pass

    return threads, meta


# --------------------------------------------------------------------------
# CPU sampling: top
# --------------------------------------------------------------------------
TOP_CLOCK_RE = re.compile(r"^top - (\d\d):(\d\d):(\d\d)\b")


def _top_blocks(text):
    """Split `top -b` output into iterations, keeping each `top - hh:mm:ss` line."""
    blocks = re.split(r"(?m)^(?=top - )", text)
    return [b for b in blocks if "PID" in b and "%CPU" in b]


def _top_clock(block):
    m = TOP_CLOCK_RE.match(block)
    if not m:
        return None
    h, mi, s = (int(x) for x in m.groups())
    return h * 3600 + mi * 60 + s


def top_window(blocks):
    """Seconds between the last two iterations, from top's own clock.

    top prints whole seconds, so this is +/-1s; good enough to label an
    offline capture, which is what it is used for.
    """
    if len(blocks) < 2:
        return None
    a, b = _top_clock(blocks[-2]), _top_clock(blocks[-1])
    if a is None or b is None:
        return None
    d = (b - a) % 86400  # an iteration pair can straddle midnight
    return float(d) if d > 0 else None


def sample_top(pid, delay, samples=2, top_bin="top"):
    """Return ({tid: sample}, raw top output)."""
    n = max(2, samples)  # first top iteration is cumulative-since-start; discard it
    base = [top_bin, "-H", "-b", "-n", str(n), "-d", "%.2f" % delay, "-p", str(pid)]

    rc, out, err = run(base + ["-w", "512"], timeout=int(delay * n) + 60)
    if rc != 0 or "PID" not in out:
        rc, out, err = run(base, timeout=int(delay * n) + 60)
    if rc != 0:
        die("top failed (rc=%d): %s\n  try --method proc" % (rc, (err or out).strip()))
    if "PID" not in out:
        die("could not understand top output (busybox top?).  try --method proc")

    blocks = _top_blocks(out)
    if not blocks:
        die("no usable samples from top; try --method proc")
    return _parse_top_block(blocks[-1]), out


def _parse_top_block(block):
    header = None
    cols = []
    result = {}
    for line in block.splitlines():
        if header is None:
            st = line.strip()
            if st.startswith("PID") and "%CPU" in st:
                header = st
                cols = st.split()
            continue
        if not line.strip():
            continue
        parts = line.split(None, len(cols) - 1)
        if len(parts) < len(cols):
            continue
        row = dict(zip(cols, parts))
        try:
            tid = int(row["PID"])
            cpu = float(row["%CPU"])
        except (KeyError, ValueError):
            continue
        result[tid] = {
            "cpu": cpu,
            "comm": row.get("COMMAND", ""),
            "time": row.get("TIME+", ""),
            "state": row.get("S", ""),
            "mem_pct": row.get("%MEM", ""),
        }
    return result


def parse_top_file(text):
    """Return (samples, window_s or None, iterations) from saved `top -H -b` output."""
    blocks = _top_blocks(text)
    if not blocks:
        die("--top-file does not look like `top -H -b` output")
    return _parse_top_block(blocks[-1]), top_window(blocks), len(blocks)


# --------------------------------------------------------------------------
# CPU sampling: /proc
# --------------------------------------------------------------------------
def _read_proc_tasks(pid):
    """{tid: (ticks, comm, state)} from /proc/<pid>/task/*/stat."""
    out = {}
    base = "/proc/%d/task" % pid
    try:
        tids = os.listdir(base)
    except OSError as e:
        die("cannot read %s: %s" % (base, e))
    for t in tids:
        if not t.isdigit():
            continue
        try:
            with open("%s/%s/stat" % (base, t)) as fh:
                data = fh.read()
        except OSError:
            continue
        parsed = _parse_stat(data)
        if parsed:
            out[int(t)] = parsed
    return out


def _parse_stat(data):
    # comm is in parens and may contain spaces/parens -> split on the last ')'
    try:
        lp = data.index("(")
        rp = data.rindex(")")
        comm = data[lp + 1 : rp]
        fields = data[rp + 2 :].split()
        return int(fields[11]) + int(fields[12]), comm, fields[0]
    except (ValueError, IndexError):
        return None


def _read_proc_process_ticks(pid):
    """utime+stime of the whole process, including threads that have exited."""
    try:
        with open("/proc/%d/stat" % pid) as fh:
            parsed = _parse_stat(fh.read())
    except OSError:
        return None
    return parsed[0] if parsed else None


def sample_proc(pid, delay):
    """Return ({tid: sample}, window_s, process_cpu_pct or None)."""
    if not IS_LINUX:
        die("--method proc needs /proc (Linux only); use --method jstack on macOS")
    hz = os.sysconf("SC_CLK_TCK") or 100
    p0 = _read_proc_process_ticks(pid)
    first = _read_proc_tasks(pid)
    t0 = time.time()
    time.sleep(delay)
    second = _read_proc_tasks(pid)
    p1 = _read_proc_process_ticks(pid)
    elapsed = max(time.time() - t0, 1e-3)

    result = {}
    for tid, (ticks, comm, state) in second.items():
        prev = first.get(tid)
        # A thread missing from the first read was born inside the window, so
        # all of its CPU time was spent inside the window: baseline 0.
        dt = ticks - (prev[0] if prev else 0)
        cpu = (dt / float(hz)) / elapsed * 100.0
        result[tid] = {
            "cpu": round(max(cpu, 0.0), 1),
            "comm": comm,
            "time": "%.2fs" % (ticks / float(hz)),
            "state": state,
            "mem_pct": "",
        }
    proc_pct = None
    if p0 is not None and p1 is not None:
        proc_pct = round(max(p1 - p0, 0) / float(hz) / elapsed * 100.0, 1)
    return result, elapsed, proc_pct


# --------------------------------------------------------------------------
# CPU sampling: jstack cpu= delta (portable, incl. macOS)
# --------------------------------------------------------------------------
def _median(values):
    v = sorted(values)
    if not v:
        return None
    mid = len(v) // 2
    return v[mid] if len(v) % 2 else (v[mid - 1] + v[mid]) / 2.0


def sample_jstack_delta(pid, delay, force=False, tool=None):
    """Two dumps, delta the per-thread cumulative `cpu=` field.

    Returns (cpu_by_nid, second_dump_text, window_s, window_source).  The
    window comes from the JVM's own per-thread `elapsed=` clock when it can,
    which excludes however long jcmd took to attach.
    """
    t0 = time.time()
    first = capture_jstack(pid, force=force, tool=tool)
    ta, _ = parse_jstack(first)
    time.sleep(delay)
    t1 = time.time()
    second = capture_jstack(pid, force=force, tool=tool)
    tb, _ = parse_jstack(second)

    if not any(t.cpu_ms is not None for t in tb):
        die(
            "this JDK's thread dump has no `cpu=` field (JDK 8?).\n"
            "  use --method top (Linux) or a JDK 11+ target for macOS support"
        )

    before = {t.nid: t for t in ta if t.nid is not None and t.cpu_ms is not None}
    deltas = [
        t.elapsed_s - before[t.nid].elapsed_s
        for t in tb
        if t.nid in before
        and t.elapsed_s is not None
        and before[t.nid].elapsed_s is not None
        and before[t.nid].name == t.name
    ]
    window = _median(deltas)
    source = "thread elapsed= clock"
    if not window or window <= 0:
        window, source = max(t1 - t0, 1e-3), "wall clock"

    result = {}
    for t in tb:
        if t.nid is None or t.cpu_ms is None:
            continue
        prev = before.get(t.nid)
        if prev is not None and prev.name != t.name:
            prev = None  # the OS reused the id for a new thread
        if prev is None and t.elapsed_s is not None and t.elapsed_s > window + 0.5:
            continue  # existed before the first dump but was not in it: no baseline
        base = prev.cpu_ms if prev is not None else 0.0
        delta = max(t.cpu_ms - base, 0.0)
        result[t.nid] = {
            "cpu": round(delta / (window * 1000.0) * 100.0, 1),
            "comm": t.name[:15],
            "time": "%.2fs" % (t.cpu_ms / 1000.0),
            "state": (t.state or t.os_state or "")[:1],
            "mem_pct": "",
        }
    return result, second, window, source


# --------------------------------------------------------------------------
# merge + analysis
# --------------------------------------------------------------------------
def normalise_name(name):
    """pool-3-thread-17 -> pool-#-thread-#  (for grouping)"""
    return re.sub(r"\d+", "#", name)


def merge(threads, cpu_by_tid):
    """Attach a cpu figure to every jstack thread; return unmatched tids too."""
    rows = []
    used = set()
    for t in threads:
        info = cpu_by_tid.get(t.nid) if t.nid is not None else None
        if info:
            used.add(t.nid)
        rows.append({"thread": t, "cpu": info["cpu"] if info else None, "sample": info})
    orphans = {tid: v for tid, v in cpu_by_tid.items() if tid not in used}
    return rows, orphans


def check_cpu_coverage(rows, orphans, method):
    """Loudly refuse to pass off 'no data' as 'nothing is using CPU'."""
    matched = sum(1 for r in rows if r["cpu"] is not None)
    if matched or orphans:
        if rows and matched < len(rows) * 0.5:
            warn(
                "only %d of %d dump threads matched a CPU sample - the dump and the "
                "sample may be from different moments" % (matched, len(rows))
            )
        return
    extra = ""
    if method == "offline":
        extra = (
            "\n  the dump has no usable `cpu=` field (JDK 8 prints none), so pass "
            "--top-file\n  with matching `top -H -b` output"
        )
    die(
        "no per-thread CPU data at all: every thread would read 0.0%%, which is not "
        "the same\n  as an idle JVM, so no report was produced.%s" % extra
    )


LOCK_RE = re.compile(r"<(?P<addr>0[xX][0-9a-fA-F]+)>(?:\s*\(a (?P<cls>[^)]+)\))?")


def _lock_of(text):
    m = LOCK_RE.search(text)
    return (m.group("addr").lower(), m.group("cls") or "") if m else (None, "")


def contended_locks(rows):
    """Locks with waiters, who holds them, and what the holder is doing.

    Monitors (`waiting to lock`) always count.  j.u.c locks (`parking to wait
    for`) only count when an owner is visible (`jstack -l`), because idle pool
    threads park on queue conditions all day and that is not contention.
    """
    by_nid_cpu = {}
    owners = {}
    for r in rows:
        t = r["thread"]
        by_nid_cpu[id(t)] = r["cpu"]
        waiting_addrs = set(_lock_of(w)[0] for w in t.waiting_on)
        for held in t.locks_held:
            addr, _ = _lock_of(held)
            # Object.wait() prints "- locked" for a monitor it has released
            if addr and addr not in waiting_addrs:
                owners.setdefault(addr, t)

    waiters = OrderedDict()
    classes = {}
    for r in rows:
        t = r["thread"]
        for w in t.waiting_on:
            if w.startswith("waiting to lock"):
                kind = "monitor"
            elif w.startswith("parking to wait"):
                kind = "park"
            else:
                continue  # `waiting on` = Object.wait(): not contention
            addr, cls = _lock_of(w)
            if not addr:
                continue
            if kind == "park" and (addr not in owners or "ConditionObject" in cls):
                continue
            if owners.get(addr) is t:
                continue
            waiters.setdefault(addr, []).append(t)
            classes[addr] = cls

    out = []
    for addr, ws in waiters.items():
        owner = owners.get(addr)
        out.append(
            OrderedDict(
                [
                    ("lock", addr),
                    ("class", classes.get(addr, "")),
                    ("waiters", sorted(set(w.name for w in ws))),
                    ("owner", owner.name if owner else None),
                    ("owner_state", (owner.state or "JVM_INTERNAL") if owner else None),
                    ("owner_cpu_pct", by_nid_cpu.get(id(owner)) if owner else None),
                    (
                        "owner_frame",
                        (owner.app_frame() or owner.top_frame()) if owner else None,
                    ),
                ]
            )
        )
    out.sort(key=lambda d: (-len(d["waiters"]), d["lock"]))
    return out


def analyse(rows, orphans, meta, ctx):
    """Every number the text report, the JSON and the hints agree on."""
    total = sum(r["cpu"] or 0.0 for r in rows) + sum(v["cpu"] for v in orphans.values())
    cap = (ctx.get("capacity") or {}).get("capacity")
    for r in rows:
        r["share"] = (
            (r["cpu"] / total * 100.0) if (r["cpu"] is not None and total > 0) else None
        )
        r["of_cap"] = (
            (r["cpu"] / cap) if (r["cpu"] is not None and cap) else None
        )  # a percent

    groups = defaultdict(lambda: {"cpu": 0.0, "n": 0, "states": Counter()})
    for r in rows:
        g = groups[normalise_name(r["thread"].name)]
        g["cpu"] += r["cpu"] or 0.0
        g["n"] += 1
        g["states"][r["thread"].state or "JVM_INTERNAL"] += 1
    group_list = [
        OrderedDict(
            [
                ("pattern", name),
                ("count", g["n"]),
                ("cpu_pct", round(g["cpu"], 2)),
                (
                    "share_of_jvm_pct",
                    round(g["cpu"] / total * 100.0, 2) if total > 0 else None,
                ),
                (
                    "states",
                    OrderedDict(
                        sorted(g["states"].items(), key=lambda kv: (-kv[1], kv[0]))
                    ),
                ),
            ]
        )
        for name, g in groups.items()
    ]
    group_list.sort(key=lambda g: (-g["cpu_pct"], g["pattern"]))

    census = Counter()
    cpu_by_state = defaultdict(float)
    for r in rows:
        s = r["thread"].state or "JVM_INTERNAL"
        census[s] += 1
        cpu_by_state[s] += r["cpu"] or 0.0
    states = [
        OrderedDict(
            [("state", s), ("count", n), ("cpu_pct", round(cpu_by_state[s], 2))]
        )
        for s, n in sorted(
            census.items(), key=lambda kv: (-kv[1], -cpu_by_state[kv[0]], kv[0])
        )
    ]

    proc_pct = ctx.get("process_cpu_pct")
    unattributed = None
    if proc_pct is not None:
        unattributed = round(max(proc_pct - total, 0.0), 1)

    return {
        "total": total,
        "cores": total / 100.0,
        "capacity": cap,
        "of_capacity": (total / (cap * 100.0)) if cap else None,  # a fraction
        "matched": sum(1 for r in rows if r["cpu"] is not None),
        "groups": group_list,
        "states": states,
        "blocked": [r for r in rows if (r["thread"].state or "") == "BLOCKED"],
        "locks": contended_locks(rows),
        "process_pct": proc_pct,
        "unattributed": unattributed,
    }


# --------------------------------------------------------------------------
# next-investigation hints (deterministic rules, no guessing)
# --------------------------------------------------------------------------
# Every hint comes from a fixed rule with fixed thresholds applied to numbers
# already in the report, so the same input always yields the same hints in the
# same order.  Rule ids are part of the JSON contract.
SEVERITY_RANK = {"critical": 0, "warning": 1, "info": 2}

GC_NAME_RE = re.compile(
    r"^(GC Thread|G1 Conc|G1 Refine|G1 Main Marker|G1 Young RemSet|ParGC Thread|"
    r"Gang worker|Concurrent Mark|ZWorker|ZDriver|ZDirector|Shenandoah|CMS )"
)
JIT_NAME_RE = re.compile(r"^(C1 CompilerThread|C2 CompilerThread|JVMCI|Sweeper thread)")
SELECTOR_FRAMES = (
    "sun.nio.ch.EPoll.wait",
    "sun.nio.ch.EPollArrayWrapper.epollWait",
    "sun.nio.ch.KQueue.poll",
    "sun.nio.ch.KQueueArrayWrapper.kevent0",
    "sun.nio.ch.Net.poll",
    "sun.nio.ch.PollArrayWrapper.poll",
    "io.netty.channel.epoll.Native.epollWait",
    "io.netty.channel.kqueue.Native.keventWait",
)
MAP_LOOP_FRAMES = (
    "java.util.HashMap$TreeNode.",
    "java.util.TreeMap.",
    "java.util.WeakHashMap.",
)

# the thresholds, in % of one core unless noted
HINT_HOT_THREAD = 80.0
HINT_REGEX = 25.0
HINT_MAP_LOOP = 50.0
HINT_SELECTOR = 10.0
HINT_GC = 50.0
HINT_GC_SHARE = 25.0  # % of the JVM's CPU, together with >= HINT_GC / 2
HINT_JIT = 50.0
HINT_NATIVE = 10.0
HINT_UNATTRIBUTED = 20.0
HINT_CAPACITY = 0.9  # fraction of capacity
HINT_IDLE = 5.0
HINT_POOL = 100.0


def _hint(rule, severity, title, detail, commands=(), evidence=(), threads=()):
    return OrderedDict(
        [
            ("id", rule),
            ("severity", severity),
            ("title", title),
            ("detail", detail),
            ("evidence", list(evidence)),
            ("commands", list(commands)),
            ("threads", list(threads)),
        ]
    )


def _where(t):
    return t.app_frame() or t.top_frame() or "(no Java frames)"


def investigation_hints(rows, orphans, meta, ctx, an):
    pid = ctx["pid"] if isinstance(ctx.get("pid"), int) else "<pid>"
    hot = sorted(
        (r for r in rows if r["cpu"] is not None),
        key=lambda r: (-r["cpu"], r["thread"].name),
    )
    total = an["total"]
    out = []
    covered = set()
    # A thread can use at most one core, or less under a fractional quota:
    # judge per-thread heat against what it could actually get.
    cap = an["capacity"]
    k = min(1.0, cap) if cap else 1.0

    # DEADLOCK -------------------------------------------------------------
    if meta.get("deadlocks"):
        names = sorted(
            set(re.findall(r'^"(.+)":\s*$', "\n".join(meta["deadlocks"]), re.M))
        )
        out.append(
            _hint(
                "DEADLOCK",
                "critical",
                "Java-level deadlock between %s"
                % (", ".join(names) or "several threads"),
                "These threads wait on each other and will never progress. Fix the lock "
                "ordering in the frames under DEADLOCK DETECTED; recovering needs a restart.",
                commands=["jcmd %s Thread.print -l > deadlock.txt" % pid],
                threads=names,
            )
        )

    # LOCK_CONTENTION ------------------------------------------------------
    for lk in [l for l in an["locks"] if len(l["waiters"]) >= 2][:3]:
        what = lk["class"] or lk["lock"]
        ev = [
            "lock <%s> (%s)" % (lk["lock"], lk["class"] or "?"),
            "waiters: " + ", ".join(lk["waiters"]),
        ]
        if lk["owner"]:
            ev.append(
                "owner: %s, %s, %s CPU, at %s"
                % (
                    lk["owner"],
                    (lk["owner_state"] or "?").lower(),
                    "?"
                    if lk["owner_cpu_pct"] is None
                    else "%.1f%%" % lk["owner_cpu_pct"],
                    lk["owner_frame"] or "?",
                )
            )
            if (lk["owner_cpu_pct"] or 0) >= 50:
                detail = (
                    "The owner is burning CPU while it holds the lock, so every waiter "
                    "stalls behind that hot path. Speed it up or move it out of the "
                    "critical section."
                )
            else:
                detail = (
                    "Look at what the owner does inside the critical section: slow work "
                    "(I/O, remote calls, big loops) there serialises every waiter."
                )
        else:
            detail = (
                "The owner is not visible in this dump. A dump taken with -l (jstack -l / "
                "jcmd Thread.print -l) lists j.u.c lock owners too."
            )
        out.append(
            _hint(
                "LOCK_CONTENTION",
                "warning",
                "%d threads blocked on %s" % (len(lk["waiters"]), what),
                detail,
                evidence=ev,
                commands=[
                    "jcmd %s Thread.print -l | grep -e '^\"' -e '%s'   # owner = header above '- locked'"
                    % (pid, lk["lock"])
                ],
                threads=lk["waiters"] + ([lk["owner"]] if lk["owner"] else []),
            )
        )

    # REGEX_BACKTRACKING ---------------------------------------------------
    rx = [
        r
        for r in hot
        if r["cpu"] >= HINT_REGEX * k
        and r["thread"].top_frame().startswith("java.util.regex.")
    ]
    if rx:
        first = rx[0]
        covered.update(id(r["thread"]) for r in rx)
        out.append(
            _hint(
                "REGEX_BACKTRACKING",
                "warning",
                "Regex backtracking in %s (%.1f%% CPU)%s"
                % (
                    first["thread"].name,
                    first["cpu"],
                    " and %d more" % (len(rx) - 1) if len(rx) > 1 else "",
                ),
                "The hottest frame is inside java.util.regex, the classic sign of "
                "catastrophic backtracking. Check the pattern applied at the frame below "
                "for nested or overlapping quantifiers such as (a+)+ or (.*)*, bound the "
                "input length, or use possessive quantifiers / atomic groups.",
                evidence=[
                    "%s: %s" % (r["thread"].name, _where(r["thread"])) for r in rx[:5]
                ],
                threads=[r["thread"].name for r in rx],
            )
        )

    # MAP_LOOP -------------------------------------------------------------
    ml = [
        r
        for r in hot
        if r["cpu"] >= HINT_MAP_LOOP * k
        and any(f.startswith(MAP_LOOP_FRAMES) for f in r["thread"].java_frames()[:5])
    ]
    if ml:
        covered.update(id(r["thread"]) for r in ml)
        out.append(
            _hint(
                "MAP_LOOP",
                "warning",
                "Hot loop inside a non-concurrent map in %s" % ml[0]["thread"].name,
                "A HashMap/TreeMap modified by several threads without locking can corrupt "
                "its internal structure and spin forever. Check whether the map used at the "
                "frame below is shared; use ConcurrentHashMap or guard it.",
                evidence=[
                    "%s: %s" % (r["thread"].name, _where(r["thread"])) for r in ml[:5]
                ],
                threads=[r["thread"].name for r in ml],
            )
        )

    # SELECTOR_SPIN --------------------------------------------------------
    sel = [
        r
        for r in hot
        if r["cpu"] >= HINT_SELECTOR * k
        and r["thread"].top_frame().startswith(SELECTOR_FRAMES)
    ]
    if sel:
        covered.update(id(r["thread"]) for r in sel)
        out.append(
            _hint(
                "SELECTOR_SPIN",
                "warning",
                "I/O selector thread %s uses %.1f%% CPU while waiting"
                % (sel[0]["thread"].name, sel[0]["cpu"]),
                "A thread parked in epoll/kqueue should use almost no CPU. This much means "
                "the selector wakes up constantly: a busy socket, a spurious-wakeup spin, or "
                "a Netty/NIO selector rebuild loop. Check the library's logs for selector "
                "warnings and look at connection churn.",
                evidence=[
                    "%s: %.1f%% in %s"
                    % (r["thread"].name, r["cpu"], r["thread"].top_frame())
                    for r in sel[:5]
                ],
                commands=["ss -tanp | grep 'pid=%s,' | wc -l" % pid],
                threads=[r["thread"].name for r in sel],
            )
        )

    # GC_CPU ---------------------------------------------------------------
    gc = [
        r
        for r in rows
        if r["cpu"]
        and r["thread"].is_jvm_internal
        and GC_NAME_RE.match(r["thread"].name)
    ]
    gc_total = sum(r["cpu"] for r in gc)
    gc_share = gc_total / total * 100.0 if total > 0 else 0.0
    if gc_total >= HINT_GC or (gc_total >= HINT_GC / 2 and gc_share >= HINT_GC_SHARE):
        out.append(
            _hint(
                "GC_CPU",
                "warning",
                "Garbage collection uses %.1f%% CPU (%.0f%% of the JVM)"
                % (gc_total, gc_share),
                "GC threads are a big share of the CPU. Either the heap is too small for the "
                "live set (look for a rising old gen / back-to-back collections) or the "
                "allocation rate is very high. Watch GC before tuning anything else.",
                commands=[
                    "jstat -gcutil %s 1000 10" % pid,
                    "jcmd %s GC.heap_info" % pid,
                ],
                threads=[
                    r["thread"].name
                    for r in sorted(gc, key=lambda r: (-r["cpu"], r["thread"].name))
                ],
            )
        )

    # JIT_CPU --------------------------------------------------------------
    jit = [r for r in rows if r["cpu"] and JIT_NAME_RE.match(r["thread"].name)]
    jit_total = sum(r["cpu"] for r in jit)
    if jit_total >= HINT_JIT:
        out.append(
            _hint(
                "JIT_CPU",
                "info",
                "JIT compiler threads use %.1f%% CPU" % jit_total,
                "Normal for a few minutes after start-up or a deploy. If it persists, look for "
                "a deoptimisation loop or a full code cache.",
                commands=[
                    "jcmd %s Compiler.queue" % pid,
                    "jcmd %s Compiler.codecache" % pid,
                ],
                threads=[
                    r["thread"].name
                    for r in sorted(jit, key=lambda r: (-r["cpu"], r["thread"].name))
                ],
            )
        )

    # HOT_THREAD -----------------------------------------------------------
    busy = [
        r
        for r in hot
        if r["cpu"] >= HINT_HOT_THREAD * k
        and not r["thread"].is_jvm_internal
        and id(r["thread"]) not in covered
    ]
    for r in busy[:3]:
        t = r["thread"]
        out.append(
            _hint(
                "HOT_THREAD",
                "warning",
                "%s is CPU-bound (%.1f%% of a core%s)"
                % (
                    t.name,
                    r["cpu"],
                    ", quota %s cores" % _fmt_cores(cap) if k < 1.0 else "",
                ),
                "Start at the frame below. A thread pinned near 100% is either a loop that "
                "does not finish or genuinely heavy work: sample it a few more times, and "
                "if the frame never moves it is a loop.",
                evidence=["%s: %s" % (t.name, _where(t))],
                commands=[
                    "%s -p %s -c 5 -i 2 -f 0 --summary-only" % (PROG, pid),
                    "asprof -d 30 -e cpu -t -f flame.html %s   # async-profiler" % pid,
                ],
                threads=[t.name],
            )
        )

    # POOL_SATURATED -------------------------------------------------------
    for g in an["groups"]:
        busy_states = sum(
            n for s, n in g["states"].items() if s in ("RUNNABLE", "BLOCKED")
        )
        if (
            g["count"] >= 3
            and busy_states == g["count"]
            and g["cpu_pct"] >= HINT_POOL
            and "#" in g["pattern"]
        ):
            out.append(
                _hint(
                    "POOL_SATURATED",
                    "warning",
                    "All %d %s threads are busy (%.1f%% CPU)"
                    % (g["count"], g["pattern"], g["cpu_pct"]),
                    "No thread in this pool is idle, so new work queues up behind them. "
                    "Find out whether the work got slower (see the hottest frames) or "
                    "whether there is simply more of it; a bigger pool only helps in the "
                    "second case, and only if there is CPU capacity left.",
                    threads=[],
                )
            )

    # NATIVE_THREAD --------------------------------------------------------
    nat = sorted(
        ((tid, v) for tid, v in orphans.items() if v["cpu"] >= HINT_NATIVE),
        key=lambda kv: (-kv[1]["cpu"], kv[0]),
    )
    if nat:
        tid, v = nat[0]
        out.append(
            _hint(
                "NATIVE_THREAD",
                "info",
                "Thread %d (%s) uses %.1f%% CPU but is not in the thread dump"
                % (tid, v["comm"] or "?", v["cpu"]),
                "Threads the dump does not list are JVM internals it omits, native threads "
                "from JNI libraries or agents, or threads that started after the dump. A "
                "native profiler can see inside them.",
                evidence=[
                    "tid %d (%s): %.1f%%" % (t_, v_["comm"] or "?", v_["cpu"])
                    for t_, v_ in nat[:5]
                ],
                commands=[
                    "cat /proc/%s/task/%d/comm" % (pid, tid),
                    "perf top -t %d" % tid,
                ],
            )
        )

    # UNATTRIBUTED_CPU -----------------------------------------------------
    if an["unattributed"] is not None and an["unattributed"] >= HINT_UNATTRIBUTED:
        out.append(
            _hint(
                "UNATTRIBUTED_CPU",
                "warning",
                "%.1f%% CPU was used by threads that no longer exist"
                % an["unattributed"],
                "The process used more CPU than its live threads account for, so threads "
                "are being created and destroyed inside the sample window. Look for code "
                "that creates a Thread or an executor per request.",
                evidence=[
                    "process %.1f%% vs live threads %.1f%%" % (an["process_pct"], total)
                ],
                commands=[
                    "jcmd %s PerfCounter.print | grep -E 'java.threads.(started|live)'"
                    % pid
                ],
            )
        )

    # CAPACITY_SATURATED ---------------------------------------------------
    if an["of_capacity"] is not None and an["of_capacity"] >= HINT_CAPACITY:
        cap = ctx["capacity"]
        cmds = []
        if cap.get("source") == "cgroup quota":
            cmds.append(
                "cat %s/cpu.stat   # nr_throttled, throttled_time/usec"
                % (cap.get("cgroup_dir") or "/sys/fs/cgroup")
            )
        out.append(
            _hint(
                "CAPACITY_SATURATED",
                "warning",
                "The JVM uses %.0f%% of the %s cores it can get"
                % (an["of_capacity"] * 100, _fmt_cores(an["capacity"])),
                "It is CPU-bound at its limit (%s), so latency grows with any extra load. "
                "Cut the hottest work below or raise the limit."
                % cap.get("source", "?"),
                commands=cmds,
            )
        )

    # JVM_IDLE -------------------------------------------------------------
    if total < HINT_IDLE and not meta.get("deadlocks"):
        out.append(
            _hint(
                "JVM_IDLE",
                "info",
                "The JVM was nearly idle (%.1f%% CPU) during the sample" % total,
                "If it is slow, it is waiting rather than computing: look at BLOCKED and "
                "WAITING threads, connection pools and downstream calls. If the problem "
                "comes and goes, sample repeatedly so you catch it.",
                commands=["%s -p %s -c 30 -i 10 --summary-only" % (PROG, pid)],
            )
        )

    # LIFETIME_AVERAGE / SHORT_WINDOW / LOW_COVERAGE -----------------------
    if ctx.get("method_id") == "offline-lifetime":
        out.append(
            _hint(
                "LIFETIME_AVERAGE",
                "info",
                "These are lifetime averages, not current CPU",
                "Without --top-file the only CPU figure is each thread's total since it "
                "started. Capture top next to the dump to see what is hot right now.",
                commands=[
                    "top -H -b -n 2 -d 5 -p %s -w 512 > top.txt; jcmd %s Thread.print -l > dump.txt"
                    % (pid, pid)
                ],
            )
        )
    win = ctx.get("window")
    if win is not None and win < 1.0:
        out.append(
            _hint(
                "SHORT_WINDOW",
                "info",
                "The sample window was only %.1fs" % win,
                "Short windows are noisy, especially with top's 0.1%-of-a-tick rounding. "
                "Use a few seconds unless you are chasing something very brief.",
                commands=["%s -p %s -d 5" % (PROG, pid)],
            )
        )
    if rows and an["matched"] < len(rows) * 0.5:
        out.append(
            _hint(
                "LOW_COVERAGE",
                "info",
                "Only %d of %d dump threads had a CPU sample"
                % (an["matched"], len(rows)),
                "The dump and the CPU sample look like they come from different moments "
                "(or different JVMs). Capture them together.",
            )
        )

    order = {h: i for i, h in enumerate(HINT_RULES)}
    out.sort(key=lambda h: (SEVERITY_RANK[h["severity"]], order.get(h["id"], 99)))
    return out


# the order rules are reported in, within a severity; also the list of valid ids
HINT_RULES = (
    "DEADLOCK",
    "PERSISTENT_LOOP",
    "LOCK_CONTENTION",
    "REGEX_BACKTRACKING",
    "MAP_LOOP",
    "HOT_THREAD",
    "SELECTOR_SPIN",
    "GC_CPU",
    "CAPACITY_SATURATED",
    "UNATTRIBUTED_CPU",
    "POOL_SATURATED",
    "BURSTY_THREAD",
    "NATIVE_THREAD",
    "JIT_CPU",
    "JVM_IDLE",
    "LIFETIME_AVERAGE",
    "SHORT_WINDOW",
    "LOW_COVERAGE",
)


def summary_hints(summary, pid):
    """Rules that only make sense across several rounds."""
    pid = pid if isinstance(pid, int) else "<pid>"
    out = []
    n = summary["rounds"]
    for t in summary["threads"]:
        frame = t["dominant_top_frame"] or ""
        if (
            n >= 3
            and t["classification"] == "persistent"
            and frame
            and t["dominant_top_frame_rounds"] == t["rounds_hot"]
            and "Native Method" not in frame
        ):
            out.append(
                _hint(
                    "PERSISTENT_LOOP",
                    "warning",
                    "%s sat on the same frame in all %d hot rounds"
                    % (t["name"], t["rounds_hot"]),
                    "Hot in every round and the top frame never moved: this is very likely "
                    "a loop that does not terminate (or a single huge unit of work). The "
                    "frame below is where to look.",
                    evidence=[
                        "%s (avg %.1f%%, max %.1f%%)"
                        % (frame, t["avg_cpu_pct"], t["max_cpu_pct"])
                    ]
                    + (
                        ["called from %s" % t["dominant_app_frame"]]
                        if t["dominant_app_frame"] and t["dominant_app_frame"] != frame
                        else []
                    ),
                    threads=[t["name"]],
                )
            )
    bursty = [
        t
        for t in summary["threads"]
        if t["classification"] in ("spike", "recurring")
        and t["max_cpu_pct"] >= HINT_HOT_THREAD
    ]
    if bursty:
        out.append(
            _hint(
                "BURSTY_THREAD",
                "info",
                "%d thread(s) spike to a full core only in some rounds" % len(bursty),
                "Bursty load: the cause may not be on screen in any single snapshot. Take "
                "shorter rounds with no pause, or run a continuous profiler.",
                evidence=[
                    "%s: max %.1f%%, hot in %d/%d rounds"
                    % (t["name"], t["max_cpu_pct"], t["rounds_hot"], n)
                    for t in bursty[:5]
                ],
                commands=["%s -p %s -c 20 -d 1 --summary-only" % (PROG, pid)],
                threads=[t["name"] for t in bursty],
            )
        )
    order = {h: i for i, h in enumerate(HINT_RULES)}
    out.sort(key=lambda h: (SEVERITY_RANK[h["severity"]], order.get(h["id"], 99)))
    return out


# --------------------------------------------------------------------------
# repeated sampling: remember every round, then say what persisted
# --------------------------------------------------------------------------
class Tracker:
    def __init__(self, hot_threshold):
        self.hot = hot_threshold
        self.rounds = 0
        self.threads = OrderedDict()
        self.totals = []
        self.hint_counts = Counter()
        self.started = None
        self.last = None
        self.pid = None

    def add(self, rows, orphans, an, hints, pid):
        now = time.time()
        if self.started is None:
            self.started = now
        self.last = now
        self.pid = pid
        idx = self.rounds
        self.rounds += 1
        for r in rows:
            if r["cpu"] is None:
                continue
            t = r["thread"]
            self._record(
                (t.nid, t.name),
                t.name,
                t.nid,
                r["cpu"],
                t.top_frame(),
                t.app_frame(),
                idx,
            )
        for tid, v in orphans.items():
            self._record(
                (tid, "native:" + v["comm"]),
                v["comm"] or "?",
                tid,
                v["cpu"],
                "",
                "",
                idx,
            )
        for e in self.threads.values():
            while len(e["series"]) < self.rounds:
                e["series"].append(None)
        self.totals.append(round(an["total"], 2))
        for h in hints:
            self.hint_counts[h["id"]] += 1

    def _record(self, key, name, nid, cpu, frame, app, idx):
        e = self.threads.get(key)
        if e is None:
            e = {
                "name": name,
                "nid": nid,
                "series": [None] * idx,
                "frames": Counter(),
                "all_frames": Counter(),
                "apps": Counter(),
            }
            self.threads[key] = e
        e["series"].append(cpu)
        if frame:
            e["all_frames"][frame] += 1
            if cpu >= self.hot:
                e["frames"][frame] += 1
        if app and cpu >= self.hot:
            e["apps"][app] += 1

    def summary(self, interrupted=False):
        n = self.rounds
        threads = []
        for e in self.threads.values():
            vals = [v for v in e["series"] if v is not None]
            hot_n = sum(1 for v in vals if v >= self.hot)
            if not hot_n:
                continue
            frames = e["frames"] or e["all_frames"]
            frame, frame_n = frames.most_common(1)[0] if frames else ("", 0)
            app = e["apps"].most_common(1)[0][0] if e["apps"] else ""
            if hot_n >= max(2, -(-4 * n // 5)):  # hot in >= 80% of rounds
                cls = "persistent"
            elif hot_n >= 2:
                cls = "recurring"
            else:
                cls = "spike"
            threads.append(
                OrderedDict(
                    [
                        ("name", e["name"]),
                        ("os_tid", e["nid"]),
                        ("rounds_present", len(vals)),
                        ("rounds_hot", hot_n),
                        ("avg_cpu_pct", round(sum(vals) / float(n), 2)),
                        ("max_cpu_pct", max(vals)),
                        ("last_cpu_pct", e["series"][-1]),
                        ("series", list(e["series"])),
                        ("dominant_top_frame", frame),
                        ("dominant_top_frame_rounds", frame_n),
                        ("dominant_app_frame", app),
                        ("classification", cls),
                    ]
                )
            )
        threads.sort(key=lambda t: (-t["avg_cpu_pct"], t["name"], t["os_tid"] or 0))
        s = OrderedDict(
            [
                ("schema", SCHEMA_ID),
                ("schema_version", SCHEMA_VERSION),
                ("kind", "summary"),
                ("tool", OrderedDict([("name", PROG), ("version", __version__)])),
                ("pid", self.pid if isinstance(self.pid, int) else None),
                ("rounds", n),
                ("duration_s", round((self.last or 0) - (self.started or 0), 2)),
                ("interrupted", bool(interrupted)),
                ("hot_threshold_pct", self.hot),
                ("total_cpu_pct_series", list(self.totals)),
                ("threads", threads),
                (
                    "hint_counts",
                    OrderedDict(
                        sorted(self.hint_counts.items(), key=lambda kv: (-kv[1], kv[0]))
                    ),
                ),
            ]
        )
        s["hints"] = summary_hints(s, self.pid)
        return s


