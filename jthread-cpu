def _r2(v):
    return None if v is None else round(v, 2)


def build_report(rows, orphans, meta, ctx, an, hints):
    cap = ctx.get("capacity") or {}
    pid = ctx.get("pid") if isinstance(ctx.get("pid"), int) else None
    total = an["total"]
    p = OrderedDict()
    p["schema"] = SCHEMA_ID
    p["schema_version"] = SCHEMA_VERSION
    p["kind"] = "report"
    p["tool"] = OrderedDict([("name", PROG), ("version", __version__)])
    p["round"] = ctx.get("round", 1)
    p["rounds_planned"] = ctx.get("rounds_planned", 1)
    p["generated_at"] = ctx["when"]
    p["sampled_at"] = ctx.get("sampled_at")
    p["pid"] = pid
    p["ppid"] = ctx.get("ppid")
    p["cmdline"] = ctx.get("cmd")
    p["method"] = ctx["method"]
    p["method_id"] = ctx["method_id"]
    p["sample_window_s"] = _r2(ctx.get("window"))
    p["window_source"] = ctx.get("window_source")
    p["cpu_count"] = cap.get("host")
    p["capacity"] = OrderedDict(
        [
            ("host_cpus", cap.get("host")),
            ("affinity_cpus", cap.get("affinity")),
            ("cgroup_quota_cores", cap.get("cgroup_quota")),
            ("capacity_cores", cap.get("capacity")),
            ("source", cap.get("source", "unknown")),
            ("cgroup_path", cap.get("cgroup_dir")),
        ]
    )
    p["cpu"] = OrderedDict(
        [
            ("unit", "percent_of_one_core"),
            ("total_pct", _r2(total)),
            ("total_cores", round(an["cores"], 3)),
            (
                "pct_of_capacity",
                _r2(an["of_capacity"] * 100.0)
                if an["of_capacity"] is not None
                else None,
            ),
            ("process_pct", an["process_pct"]),
            ("unattributed_pct", an["unattributed"]),
        ]
    )
    p["total_thread_cpu_pct"] = _r2(total)
    p["process"] = ctx.get("proc")
    p["coverage"] = OrderedDict(
        [
            ("threads_in_dump", len(rows)),
            ("threads_with_cpu", an["matched"]),
            ("unmatched_native", len(orphans)),
        ]
    )
    p["deadlocks"] = meta.get("deadlocks", [])
    p["deadlock_stacks"] = meta.get("deadlock_detail", "")
    p["threads"] = []
    for r in sorted(
        rows,
        key=lambda r: (-(r["cpu"] if r["cpu"] is not None else -1), r["thread"].name),
    ):
        d = r["thread"].to_dict()
        d["pid"] = pid
        d["cpu_pct"] = r["cpu"]
        d["cpu_pct_of_capacity"] = _r2(r["of_cap"])
        d["share_of_jvm_pct"] = _r2(r["share"])
        d["os_comm"] = r["sample"]["comm"] if r["sample"] else None
        d["cpu_time_total"] = r["sample"]["time"] if r["sample"] else None
        p["threads"].append(d)
    p["unmatched_native_threads"] = [
        OrderedDict(
            [
                ("pid", pid),
                ("os_tid", tid),
                ("nid_hex", hex(tid)),
                ("cpu_pct", v["cpu"]),
                (
                    "share_of_jvm_pct",
                    _r2(v["cpu"] / total * 100.0) if total > 0 else None,
                ),
                ("comm", v["comm"]),
            ]
        )
        for tid, v in sorted(orphans.items(), key=lambda kv: (-kv[1]["cpu"], kv[0]))
    ]
    p["groups"] = an["groups"]
    p["states"] = an["states"]
    p["contended_locks"] = an["locks"]
    p["hints"] = hints
    return p


def build_series(reports, summary):
    return OrderedDict(
        [
            ("schema", SCHEMA_ID),
            ("schema_version", SCHEMA_VERSION),
            ("kind", "series"),
            ("tool", OrderedDict([("name", PROG), ("version", __version__)])),
            ("reports", reports),
            ("summary", summary),
        ]
    )


def emit_json(doc, compact=False):
    if compact:
        sys.stdout.write(json.dumps(doc, separators=(",", ":")) + "\n")
    else:
        json.dump(doc, sys.stdout, indent=2)
        sys.stdout.write("\n")
    sys.stdout.flush()


