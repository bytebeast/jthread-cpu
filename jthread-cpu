def state_color(state):
    """Looked up late, so --no-color (which blanks C) is honoured."""
    return {
        "RUNNABLE": C.GREEN,
        "BLOCKED": C.RED,
        "WAITING": C.GREY,
        "TIMED_WAITING": C.GREY,
        "NEW": C.SKY,
        "TERMINATED": C.MAROON,
        "JVM_INTERNAL": C.LAVENDER,
    }.get(state, C.TEXT)


def cpu_color(pct):
    """Catppuccin heat ramp: teal -> green -> yellow -> peach -> red (% of one core)."""
    if pct >= 80:
        return C.RED + C.BOLD
    if pct >= 40:
        return C.PEACH + C.BOLD
    if pct >= 15:
        return C.YELLOW
    if pct >= 5:
        return C.GREEN
    if pct > 0:
        return C.TEAL
    return C.GREY


def load_color(frac):
    """Colour for a fraction of total capacity."""
    if frac is None:
        return C.TEXT
    return cpu_color(frac * 100.0)


def bar(pct, width=14):
    """A full bar is one core: the most a single thread can use."""
    filled = int(round(max(min(pct, 100.0), 0.0) / 100.0 * width))
    return G.BAR * filled + G.EMPTY * (width - filled)


def sparkline(series, full=100.0):
    out = []
    for v in series:
        if v is None:
            out.append(G.GAP)
        else:
            lvl = int(min(max(v, 0.0), full) / full * (len(G.SPARK) - 1) + 0.5)
            out.append(G.SPARK[lvl])
    return "".join(out)


def shorten_frame(frame, width):
    """Compress com.foo.bar.Baz.qux -> c.f.b.Baz.qux when it will not fit."""
    if len(frame) <= width:
        return frame
    m = re.match(r"^([\w.$]+)\.([\w$<>]+)\((.*)\)$", frame)
    if m:
        cls, meth, loc = m.groups()
        parts = cls.split(".")
        pkg = ".".join(p[0] for p in parts[:-1])
        short = "%s.%s.%s(%s)" % (pkg, parts[-1], meth, loc)
        if len(short) <= width:
            return short
        frame = short
    return frame[: max(1, width - len(G.ELLIPSIS))] + G.ELLIPSIS


def clip(text, width):
    return (
        text
        if len(text) <= width
        else text[: max(1, width - len(G.ELLIPSIS))] + G.ELLIPSIS
    )


def _fmt_cores(c):
    if c is None:
        return "?"
    return (
        ("%d" % c) if abs(c - round(c)) < 1e-9 else ("%.2f" % c).rstrip("0").rstrip(".")
    )


def _wrap(text, width, indent):
    import textwrap

    return textwrap.wrap(
        text,
        max(30, width - len(indent)),
        initial_indent=indent,
        subsequent_indent=indent,
    )


def scaled(pct, ctx, args):
    """%CPU in the unit the user asked for (--scale)."""
    if pct is None:
        return None
    cap = (ctx.get("capacity") or {}).get("capacity")
    if args.scale == "capacity" and cap:
        return pct / cap
    return pct


def section(title, color=None):
    return "\n%s  %s%s\n" % (
        C.BOLD + (color if color is not None else C.LAVENDER),
        title,
        C.RESET,
    )


def render_banner(ctx, an, args, width, title="JVM thread CPU report"):
    out = []
    t = " %s " % title
    out.append("\n%s%s%s\n" % (C.BOLD + C.MAUVE, t.center(width, "="), C.RESET))
    line1 = "pid %s" % (ctx["pid"] if ctx.get("pid") is not None else "(from file)")
    if ctx.get("ppid") is not None:
        line1 += " %s(ppid %s)%s" % (C.DIM, ctx["ppid"], C.RESET)
    if ctx.get("cmd"):
        line1 += "   %s%s%s" % (
            C.DIM,
            shorten_frame(ctx["cmd"], max(20, width - len(line1) - 6)),
            C.RESET,
        )
    out.append("  %s\n" % line1)

    win = ctx.get("window")
    win_txt = "%.1fs" % win if win is not None else "n/a"
    if ctx.get("window_source") and win is not None:
        win_txt += " %s(%s)%s" % (C.DIM, ctx["window_source"], C.RESET)
    out.append(
        "  %ssampled:%s %s   %smethod:%s %s   %swindow:%s %s\n"
        % (
            C.DIM,
            C.RESET,
            ctx["when"],
            C.DIM,
            C.RESET,
            ctx["method"],
            C.DIM,
            C.RESET,
            win_txt,
        )
    )

    cap = ctx.get("capacity") or {}
    if cap.get("capacity"):
        bits = []
        if cap.get("host") is not None and cap["source"] != "host":
            bits.append("host %s" % cap["host"])
        if cap.get("affinity") is not None and cap["affinity"] != cap.get("host"):
            bits.append("affinity %s" % cap["affinity"])
        if cap.get("cgroup_quota") is not None:
            bits.append("cgroup quota %s" % _fmt_cores(cap["cgroup_quota"]))
        detail = (
            (
                " %s(%s; limited by %s)%s"
                % (C.DIM, ", ".join(bits), cap["source"], C.RESET)
            )
            if bits
            else (" %s(%s)%s" % (C.DIM, cap["source"], C.RESET))
        )
        cap_txt = "%s cores%s" % (_fmt_cores(cap["capacity"]), detail)
    else:
        cap_txt = "%sunknown - pass --cpus N to normalise%s" % (C.DIM, C.RESET)
    proc = ctx.get("proc")
    extra = ""
    if proc:
        extra = "   %srss:%s %.0f MB   %suptime:%s %s" % (
            C.DIM,
            C.RESET,
            proc["rss_kb"] / 1024.0,
            C.DIM,
            C.RESET,
            proc["elapsed"],
        )
    out.append("  %scapacity:%s %s%s\n" % (C.DIM, C.RESET, cap_txt, extra))

    out.append(
        "  %sthreads:%s %d in dump, %d with CPU samples, %d not in dump\n"
        % (C.DIM, C.RESET, ctx["n_threads"], an["matched"], ctx["n_orphans"])
    )

    total = an["total"]
    line = "  %stotal CPU:%s %s%.1f%%%s %s= %.2f cores%s" % (
        C.DIM,
        C.RESET,
        load_color(an["of_capacity"]),
        total,
        C.RESET,
        C.DIM,
        an["cores"],
        C.RESET,
    )
    if an["of_capacity"] is not None:
        line += "   %s%s%s %s%.1f%% of capacity%s" % (
            load_color(an["of_capacity"]),
            bar(an["of_capacity"] * 100.0, 20),
            C.RESET,
            C.BOLD,
            an["of_capacity"] * 100.0,
            C.RESET,
        )
    out.append(line + "\n")
    if an["process_pct"] is not None:
        out.append(
            "  %sprocess CPU:%s %.1f%%   %snot in a live thread:%s %.1f%%\n"
            % (
                C.DIM,
                C.RESET,
                an["process_pct"],
                C.DIM,
                C.RESET,
                an["unattributed"] or 0.0,
            )
        )
    if args.scale == "capacity" and cap.get("capacity"):
        out.append(
            "  %s(%%CAP below: 100%% = all %s cores; %%JVM = share of this JVM's CPU)%s\n"
            % (C.DIM, _fmt_cores(cap["capacity"]), C.RESET)
        )
    else:
        out.append(
            "  %s(%%CPU below: 100%% = one core, like top; %%JVM = share of this JVM's CPU)%s\n"
            % (C.DIM, C.RESET)
        )
    return "".join(out)


def render_hints(hints, width):
    if not hints:
        return ""
    tag = {
        "critical": (C.BG_RED + C.BOLD, " CRIT "),
        "warning": (C.PEACH + C.BOLD, " WARN "),
        "info": (C.BLUE, " INFO "),
    }
    out = [section("NEXT STEPS")]
    for h in hints:
        col, label = tag[h["severity"]]
        out.append(
            "  %s%s%s %s%s%s %s[%s]%s\n"
            % (
                col,
                label,
                C.RESET,
                C.BOLD,
                h["title"],
                C.RESET,
                C.DIM,
                h["id"],
                C.RESET,
            )
        )
        for l in _wrap(h["detail"], width, "         "):
            out.append("%s%s%s\n" % (C.TEXT, l, C.RESET))
        for e in h["evidence"]:
            out.append(
                "         %s%s %s%s\n" % (C.DIM, G.ARROW, clip(e, width - 12), C.RESET)
            )
        for c in h["commands"]:
            out.append("         %s$ %s%s\n" % (C.SKY, c, C.RESET))
    return "".join(out)


def render(rows, orphans, meta, ctx, an, hints, args):
    width = term_width()
    out = []
    w = out.append
    title = "JVM thread CPU report"
    if ctx.get("round_label"):
        title += " " + ctx["round_label"]
    w(render_banner(ctx, an, args, width, title))

    # ---- deadlocks first: nothing else matters if the JVM is wedged -------
    if meta.get("deadlocks"):
        w(
            "\n%s%s%s\n"
            % (C.BG_RED + C.BOLD, " DEADLOCK DETECTED ".center(width), C.RESET)
        )
        for d in meta["deadlocks"]:
            for l in d.splitlines():
                w("  %s%s%s\n" % (C.RED, l, C.RESET))

    # ---- hot thread table -------------------------------------------------
    shown = [r for r in rows if r["cpu"] is not None and r["cpu"] >= args.min_cpu]
    shown.sort(key=lambda r: (-(r["cpu"] or 0), r["thread"].name))
    if args.top:
        shown = shown[: args.top]

    unit = "%CAP" if (args.scale == "capacity" and an["capacity"]) else "%CPU"
    w(section("HOTTEST THREADS"))
    hdr = "  %6s  %-14s  %4s  %7s  %8s  %-10s  %-14s  %s" % (
        unit,
        "",
        "%JVM",
        "PID",
        "TID",
        "NID(dump)",
        "STATE",
        "THREAD NAME",
    )
    w("%s%s%s\n" % (C.DIM, hdr, C.RESET))
    w("%s  %s%s\n" % (C.DIM, "-" * (width - 4), C.RESET))
    if not shown:
        w("  %s(no thread above %.1f%% CPU)%s\n" % (C.GREY, args.min_cpu, C.RESET))

    owner = ctx.get("pid")
    owner = owner if owner is not None else "?"
    name_width = max(20, width - 83)

    def share_txt(share):
        return "%3.0f%%" % share if share is not None else "   -"

    for r in shown:
        t = r["thread"]
        pct = r["cpu"]
        state = t.state or "JVM_INTERNAL"
        w(
            "  %s%6.1f%s  %s%s%s  %s%s%s  %s%7s%s  %8s  %-10s  %s%-14s%s  %s%s%s\n"
            % (
                cpu_color(pct),
                scaled(pct, ctx, args),
                C.RESET,
                cpu_color(pct),
                bar(pct),
                C.RESET,
                C.DIM,
                share_txt(r["share"]),
                C.RESET,
                C.GREY,
                owner,
                C.RESET,
                t.nid if t.nid is not None else "?",
                t.nid_raw or "?",
                state_color(state),
                state,
                C.RESET,
                C.BOLD if pct >= 40 else "",
                clip(t.name, name_width),
                C.RESET,
            )
        )
        frame = t.top_frame()
        if frame and not args.no_frames:
            w(
                "          %s%s %s%s\n"
                % (C.DIM, G.ARROW, shorten_frame(frame, width - 14), C.RESET)
            )
        if t.waiting_on:
            w(
                "          %s%s %s%s\n"
                % (C.PEACH, G.WAIT, clip(t.waiting_on[0], width - 14), C.RESET)
            )

    # ---- threads the dump did not name ------------------------------------
    orph = [
        (tid, v)
        for tid, v in sorted(orphans.items(), key=lambda kv: (-kv[1]["cpu"], kv[0]))
        if v["cpu"] >= args.min_cpu
    ]
    if orph:
        w(
            "\n%s  NOT IN THREAD DUMP%s %s(GC / JIT / VM internals, native threads, or started after the dump)%s\n"
            % (C.BOLD + C.LAVENDER, C.RESET, C.DIM, C.RESET)
        )
        total = an["total"]
        for tid, v in orph:
            share = v["cpu"] / total * 100.0 if total > 0 else None
            w(
                "  %s%6.1f%s  %s%s%s  %s%s%s  %s%7s%s  %8s  %-10s  %s%-14s%s  %s%s%s\n"
                % (
                    cpu_color(v["cpu"]),
                    scaled(v["cpu"], ctx, args),
                    C.RESET,
                    cpu_color(v["cpu"]),
                    bar(v["cpu"]),
                    C.RESET,
                    C.DIM,
                    share_txt(share),
                    C.RESET,
                    C.GREY,
                    owner,
                    C.RESET,
                    tid,
                    hex(tid),
                    C.BLUE,
                    "native",
                    C.RESET,
                    C.DIM,
                    clip(v["comm"], name_width),
                    C.RESET,
                )
            )

    # ---- grouped roll-up --------------------------------------------------
    if not args.no_groups:
        interesting = [g for g in an["groups"] if g["cpu_pct"] > 0 or g["count"] > 1][
            :12
        ]
        if interesting:
            w(section("CPU BY THREAD GROUP"))
            w(
                "%s  %6s  %4s  %5s  %-34s %s%s\n"
                % (C.DIM, unit, "%JVM", "COUNT", "NAME PATTERN", "STATES", C.RESET)
            )
            for g in interesting:
                states = ", ".join(
                    "%s%s%d" % (s.split("_")[0].lower(), G.TIMES, c)
                    for s, c in list(g["states"].items())[:3]
                )
                w(
                    "  %s%6.1f%s  %s%s%s  %5d  %-34s %s%s%s\n"
                    % (
                        cpu_color(g["cpu_pct"]),
                        scaled(g["cpu_pct"], ctx, args),
                        C.RESET,
                        C.DIM,
                        share_txt(g["share_of_jvm_pct"]),
                        C.RESET,
                        g["count"],
                        clip(g["pattern"], 34),
                        C.DIM,
                        states,
                        C.RESET,
                    )
                )

    # ---- state census -----------------------------------------------------
    w(section("THREAD STATES"))
    parts = [
        "%s%s%s %d (%.1f%% cpu)"
        % (
            state_color(s["state"]),
            s["state"].lower(),
            C.RESET,
            s["count"],
            s["cpu_pct"],
        )
        for s in an["states"]
    ]
    w("  " + "   ".join(parts) + "\n")

    blocked = an["blocked"]
    if blocked:
        w(
            "\n%s  BLOCKED THREADS%s %s(%d)%s\n"
            % (C.BOLD + C.RED, C.RESET, C.DIM, len(blocked), C.RESET)
        )
        for r in blocked[:10]:
            t = r["thread"]
            w(
                "  %s%-30s%s %s%s%s\n"
                % (
                    C.RED,
                    clip(t.name, 30),
                    C.RESET,
                    C.DIM,
                    clip(
                        t.waiting_on[0] if t.waiting_on else t.top_frame(), width - 36
                    ),
                    C.RESET,
                )
            )

    # ---- full stacks for the hottest --------------------------------------
    if args.frames > 0:
        deep = [r for r in shown if (r["cpu"] or 0) >= max(args.min_cpu, 0.1)][
            : args.stacks
        ]
        if deep:
            w(section("STACKS OF THE HOTTEST THREADS"))
            for r in deep:
                t = r["thread"]
                state = t.state or "JVM_INTERNAL"
                nid_disp = t.nid_raw or "?"
                if t.nid_hex and t.nid_hex != t.nid_raw:
                    nid_disp += " (%s)" % t.nid_hex
                w(
                    '\n  %s%.1f%%%s  %s"%s"%s  %spid=%s tid=%s nid=%s %s%s\n'
                    % (
                        cpu_color(r["cpu"]),
                        r["cpu"],
                        C.RESET,
                        C.BOLD,
                        t.name,
                        C.RESET,
                        C.DIM,
                        owner,
                        t.nid,
                        nid_disp,
                        state.lower(),
                        C.RESET,
                    )
                )
                if not t.frames:
                    w(
                        "      %s(no java frames - native/VM thread)%s\n"
                        % (C.GREY, C.RESET)
                    )
                for f in t.frames[: args.frames]:
                    if f.startswith("- "):
                        w(
                            "      %s%s%s\n"
                            % (C.PEACH, shorten_frame(f, width - 8), C.RESET)
                        )
                    else:
                        w("      %s\n" % shorten_frame(f, width - 8))
                if len(t.frames) > args.frames:
                    w(
                        "      %s... %d more frames%s\n"
                        % (C.GREY, len(t.frames) - args.frames, C.RESET)
                    )

    if not args.no_hints:
        w(render_hints(hints, width))
    w("\n")
    sys.stdout.write("".join(out))
    sys.stdout.flush()


def render_summary(summary, args):
    width = term_width()
    out = []
    w = out.append
    n = summary["rounds"]
    title = " persistent hotspots: %d rounds over %.1fs%s " % (
        n,
        summary["duration_s"],
        " (interrupted)" if summary["interrupted"] else "",
    )
    w("\n%s%s%s\n" % (C.BOLD + C.MAUVE, title.center(width, "="), C.RESET))
    w(
        "  %shot = at least %.0f%% of one core in a round;  avg counts absent rounds as 0%s\n"
        % (C.DIM, summary["hot_threshold_pct"], C.RESET)
    )
    tot = summary["total_cpu_pct_series"]
    if tot:
        peak = max(tot) or 1.0
        w(
            "  %stotal CPU per round:%s %s  %savg %.1f%%  min %.1f%%  max %.1f%%%s\n"
            % (
                C.DIM,
                C.RESET,
                sparkline(tot[-60:], full=peak),
                C.DIM,
                sum(tot) / len(tot),
                min(tot),
                max(tot),
                C.RESET,
            )
        )

    threads = summary["threads"]
    if args.top:
        threads = threads[: args.top]
    w(section("THREADS THAT WERE HOT"))
    if not threads:
        w(
            "  %s(no thread reached %.0f%% of a core in any round)%s\n"
            % (C.GREY, summary["hot_threshold_pct"], C.RESET)
        )
    else:
        spark_w = max(9, min(n, 30))
        w(
            "%s  %6s  %6s  %5s  %-*s  %-10s  %s%s\n"
            % (
                C.DIM,
                "AVG",
                "MAX",
                "HOT",
                spark_w,
                "PER ROUND",
                "PATTERN",
                "THREAD",
                C.RESET,
            )
        )
        cls_col = {"persistent": C.RED, "recurring": C.PEACH, "spike": C.YELLOW}
        for t in threads:
            w(
                "  %s%6.1f%s  %6.1f  %5s  %s%-*s%s  %s%-10s%s  %s%s%s\n"
                % (
                    cpu_color(t["avg_cpu_pct"]),
                    t["avg_cpu_pct"],
                    C.RESET,
                    t["max_cpu_pct"],
                    "%d/%d" % (t["rounds_hot"], n),
                    cpu_color(t["max_cpu_pct"]),
                    spark_w,
                    sparkline(t["series"][-spark_w:]),
                    C.RESET,
                    cls_col.get(t["classification"], ""),
                    t["classification"],
                    C.RESET,
                    C.BOLD,
                    clip(t["name"], max(20, width - 50 - spark_w)),
                    C.RESET,
                )
            )
            if t["dominant_top_frame"] and not args.no_frames:
                w(
                    "          %s%s %s  (%d/%d hot rounds)%s\n"
                    % (
                        C.DIM,
                        G.ARROW,
                        shorten_frame(t["dominant_top_frame"], width - 40),
                        t["dominant_top_frame_rounds"],
                        t["rounds_hot"],
                        C.RESET,
                    )
                )

    if summary["hint_counts"]:
        w(section("HINTS RAISED ACROSS ROUNDS"))
        w(
            "  "
            + "   ".join(
                "%s %s%s%d%s" % (k, C.DIM, G.TIMES, v, C.RESET)
                for k, v in summary["hint_counts"].items()
            )
            + "\n"
        )
    if not args.no_hints:
        w(render_hints(summary["hints"], width))
    w("\n")
    sys.stdout.write("".join(out))
    sys.stdout.flush()


