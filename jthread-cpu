def read_text_file(path, label):
    try:
        with open(path, errors="replace") as fh:
            return fh.read()
    except OSError as e:
        die("cannot read %s %s: %s" % (label, path, e.strerror or e))


def find_java_pids():
    """Return [(pid, description), ...] for running JVMs."""
    found = {}

    rc, out, _ = run(["jps", "-l"])
    if rc == 0:
        for line in out.splitlines():
            parts = line.split(None, 1)
            if len(parts) >= 1 and parts[0].isdigit():
                pid = int(parts[0])
                name = parts[1] if len(parts) > 1 else "?"
                if "sun.tools.jps" in name or "jdk.jcmd" in name:
                    continue
                found[pid] = name

    if not found:
        rc, out, _ = run(["pgrep", "-f", r"java"])
        if rc == 0:
            for line in out.split():
                if line.isdigit():
                    found.setdefault(int(line), process_cmdline(int(line)) or "java")

    return sorted(found.items())


def process_cmdline(pid):
    if IS_LINUX:
        try:
            with open("/proc/%d/cmdline" % pid, "rb") as fh:
                raw = fh.read().replace(b"\x00", b" ").strip()
            if raw:
                return raw.decode("utf-8", "replace")
        except OSError:
            return None
    rc, out, _ = run(["ps", "-o", "command=", "-p", str(pid)])
    if rc == 0:
        return out.strip() or None
    return None


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def process_cpu_percent(pid):
    """Whole-process %CPU as ps sees it (average since start; context only)."""
    rc, out, _ = run(["ps", "-o", "%cpu=,rss=,etime=", "-p", str(pid)])
    if rc != 0 or not out.strip():
        return None
    f = out.split()
    try:
        return {"cpu_pct": float(f[0]), "rss_kb": int(f[1]), "elapsed": f[2]}
    except (IndexError, ValueError):
        return None


def parent_pid(pid):
    """PPid of the JVM itself - the shell, systemd or container runtime."""
    if IS_LINUX:
        try:
            with open("/proc/%d/status" % pid) as fh:
                for line in fh:
                    if line.startswith("PPid:"):
                        return int(line.split()[1])
        except (OSError, ValueError, IndexError):
            return None
        return None
    rc, out, _ = run(["ps", "-o", "ppid=", "-p", str(pid)])
    if rc == 0 and out.strip().isdigit():
        return int(out.strip())
    return None


def cpu_count():
    try:
        return os.cpu_count() or 1
    except Exception:
        return 1


def _read_first_line(path):
    try:
        with open(path) as fh:
            return fh.readline().strip()
    except (OSError, UnicodeDecodeError):
        return None


CGROUP_ROOT = "/sys/fs/cgroup"  # module-level so tests can point it at a fake tree
PROC_ROOT = "/proc"


def _cgroup_limit_at(kind, d):
    """Quota in cores set directly on cgroup directory `d`, or None."""
    try:
        if kind == "v2":
            raw = _read_first_line(os.path.join(d, "cpu.max"))
            f = raw.split() if raw else []
            if len(f) == 2 and f[0] != "max":
                return int(f[0]) / float(f[1])
        else:
            qs = _read_first_line(os.path.join(d, "cpu.cfs_quota_us"))
            ps = _read_first_line(os.path.join(d, "cpu.cfs_period_us"))
            if qs and ps and int(qs) > 0:
                return int(qs) / float(ps)
    except (ValueError, ZeroDivisionError):
        pass
    return None


def _cgroup_quota_cores(pid):
    return _cgroup_quota(pid)[0]


def _cgroup_quota(pid):
    """(quota in cores or None, cgroup directory that sets it or None).

    CPU quota (in cores) applying to `pid`, or None when unlimited/unknown.

    cgroup v2: cpu.max = "<quota|max> <period>".  cgroup v1: cpu.cfs_quota_us
    / cpu.cfs_period_us.  Every ancestor can carry its own limit, so the
    tightest one on the path wins.  When the target lives in another cgroup
    namespace (we run on the host, the JVM in a container) its path is
    resolved under our cgroup mount; if that fails we fall back to our own
    cgroup, which is right when we were exec'd into the same container.
    """
    if not IS_LINUX and CGROUP_ROOT == "/sys/fs/cgroup":
        return None, None
    try:
        with open(os.path.join(PROC_ROOT, str(pid), "cgroup")) as fh:
            lines = fh.read().splitlines()
    except OSError:
        lines = []

    v1_mounts = ("cpu,cpuacct", "cpuacct,cpu", "cpu")
    candidates = []  # (kind, hierarchy root, leaf directory)
    for line in lines:
        parts = line.split(":", 2)
        if len(parts) != 3:
            continue
        hid, ctrls, path = parts
        rel = path.strip().strip("/")
        if hid == "0" and ctrls == "":
            candidates.append(("v2", CGROUP_ROOT, os.path.join(CGROUP_ROOT, rel)))
        elif "cpu" in ctrls.split(","):
            for mnt in v1_mounts:
                root = os.path.join(CGROUP_ROOT, mnt)
                candidates.append(("v1", root, os.path.join(root, rel)))
    # our own view, for the "we live inside the same container" case
    candidates.append(("v2", CGROUP_ROOT, CGROUP_ROOT))
    for mnt in v1_mounts:
        root = os.path.join(CGROUP_ROOT, mnt)
        candidates.append(("v1", root, root))

    for kind, root, leaf in candidates:
        marker = "cpu.max" if kind == "v2" else "cpu.cfs_quota_us"
        if not os.path.isfile(os.path.join(leaf, marker)):
            continue  # not this hierarchy, or a path from another namespace
        best, best_dir = None, None
        d = leaf
        while True:
            q = _cgroup_limit_at(kind, d)
            if q is not None and q > 0 and (best is None or q < best):
                best, best_dir = q, d
            if os.path.normpath(d) == os.path.normpath(root):
                break
            parent = os.path.dirname(d)
            if parent == d or not parent.startswith(root):
                break
            d = parent
        return best, best_dir  # the first readable hierarchy is authoritative
    return None, None


def cpu_capacity(pid=None, override=None):
    """How much CPU the JVM can actually use, in cores.

    Returns a dict: host (online CPUs), affinity (CPUs in the target's affinity
    mask), cgroup_quota (cores, or None), capacity (the smallest of those) and
    source (which one set the capacity).  `override` (--cpus) wins outright.
    """
    info = OrderedDict(
        [
            ("host", None),
            ("affinity", None),
            ("cgroup_quota", None),
            ("capacity", None),
            ("source", "unknown"),
            ("cgroup_dir", None),
        ]
    )
    if override:
        info["capacity"] = float(override)
        info["source"] = "--cpus"
        return info
    info["host"] = cpu_count()
    info["capacity"] = float(info["host"])
    info["source"] = "host"
    if hasattr(os, "sched_getaffinity"):
        try:
            aff = len(os.sched_getaffinity(pid or 0))
            info["affinity"] = aff
            if aff < info["capacity"]:
                info["capacity"], info["source"] = float(aff), "affinity"
        except OSError:
            pass
    if pid:
        q, qdir = _cgroup_quota(pid)
        if q is not None:
            info["cgroup_quota"] = round(q, 2)
            info["cgroup_dir"] = qdir
            if q < info["capacity"]:
                info["capacity"], info["source"] = round(q, 2), "cgroup quota"
    return info


