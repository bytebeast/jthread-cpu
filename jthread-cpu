def _iso_now():
    return datetime.datetime.now().astimezone().replace(microsecond=0).isoformat()


def _iso_from_dump(ts):
    try:
        return datetime.datetime.strptime(ts[:19], "%Y-%m-%d %H:%M:%S").isoformat()
    except (ValueError, TypeError):
        return None


def save_round(save_dir, idx, raw, report):
    try:
        os.makedirs(save_dir, exist_ok=True)
        stem = os.path.join(save_dir, "round-%03d" % idx)
        with open(stem + "-dump.txt", "w") as fh:
            fh.write(raw["dump"])
        if raw.get("top"):
            with open(stem + "-top.txt", "w") as fh:
                fh.write(raw["top"])
        elif raw.get("cpu") is not None:
            with open(stem + "-cpu.json", "w") as fh:
                json.dump(
                    {str(k): v for k, v in sorted(raw["cpu"].items())}, fh, indent=1
                )
        with open(stem + "-report.json", "w") as fh:
            json.dump(report, fh, indent=2)
    except OSError as e:
        warn("could not save round %d to %s: %s" % (idx, save_dir, e))


def resolve_method(args):
    method = args.method
    if method == "auto":
        method = (
            "top"
            if IS_LINUX and shutil.which(args.top_bin)
            else ("proc" if IS_LINUX else "jstack")
        )
    if method in ("top", "proc") and not IS_LINUX:
        why = (
            " (macOS has no `top -H`, and nid there is a mach port, not a TID)"
            if IS_MAC
            else ""
        )
        warn("--method %s needs Linux%s; using --method jstack instead" % (method, why))
        method = "jstack"
    return method


def collect_live(pid, method, args, capacity):
    """One round: sample CPU, take a dump, join.  Returns (rows, orphans, meta, ctx, raw)."""
    raw = {"dump": None, "top": None, "cpu": None}
    dump = None
    proc_pct = None
    sampled_at = _iso_now()
    when = time.strftime("%Y-%m-%d %H:%M:%S %Z")
    if method == "jstack":
        cpu, dump, window, wsrc = sample_jstack_delta(
            pid, args.delay, force=args.force, tool=args.jstack_bin
        )
        label = "two thread dumps, cpu= delta"
    elif method == "proc":
        cpu, window, proc_pct = sample_proc(pid, args.delay)
        wsrc = "measured"
        label = "/proc/%d/task" % pid
    else:
        cpu, raw["top"] = sample_top(pid, args.delay, args.samples, args.top_bin)
        window, wsrc = args.delay, "top -d"
        label = "top -H -b"
    raw["cpu"] = cpu
    if dump is None:
        dump = capture_jstack(pid, force=args.force, tool=args.jstack_bin)
    raw["dump"] = dump
    threads, meta = parse_jstack(dump)
    if not threads:
        die("the thread dump contained no threads - is pid %d really a JVM?" % pid)
    rows, orphans = merge(threads, cpu)
    check_cpu_coverage(rows, orphans, method)
    ctx = {
        "pid": pid,
        "cmd": process_cmdline(pid),
        "when": when,
        "sampled_at": sampled_at,
        "method": label,
        "method_id": method,
        "window": window,
        "window_source": wsrc,
        "capacity": capacity,
        "proc": process_cpu_percent(pid),
        "ppid": parent_pid(pid),
        "process_cpu_pct": proc_pct,
        "n_threads": len(rows),
        "n_orphans": len(orphans),
    }
    return rows, orphans, meta, ctx, raw


def collect_offline(args):
    dump = _strip_launcher_noise(read_text_file(args.jstack_file, "--jstack-file"))
    threads, meta = parse_jstack(dump)
    if not threads:
        die(
            "no thread dump found in %s\n"
            '  expected jstack/jcmd Thread.print output with "name" ... nid= lines'
            % args.jstack_file
        )
    top_raw = None
    if args.top_file:
        top_raw = read_text_file(args.top_file, "--top-file")
        cpu, window, iters = parse_top_file(top_raw)
        wsrc = "top clock" if window else None
        if window is None:
            if iters < 2:
                warn(
                    "--top-file has a single top iteration; its %CPU may not cover a "
                    "short recent window (capture with -n 2)"
                )
            window = args.delay
            wsrc = "-d" if window else None
        method, method_id = "files (top + jstack)", "offline-top"
    else:
        # no top data: fall back to the dump's own cumulative cpu= field
        cpu = {}
        for t in threads:
            if t.nid is not None and t.cpu_ms is not None and t.elapsed_s:
                cpu[t.nid] = {
                    "cpu": round(t.cpu_ms / (t.elapsed_s * 1000.0) * 100.0, 1),
                    "comm": t.name[:15],
                    "time": "%.2fs" % (t.cpu_ms / 1000.0),
                    "state": "",
                    "mem_pct": "",
                }
        window, wsrc = None, None
        method, method_id = "jstack cpu= / lifetime average", "offline-lifetime"
        warn("no --top-file: showing lifetime average CPU, not current usage")
    rows, orphans = merge(threads, cpu)
    check_cpu_coverage(rows, orphans, "offline")
    capacity = (
        cpu_capacity(override=args.cpus)
        if args.cpus
        else OrderedDict(
            [
                ("host", None),
                ("affinity", None),
                ("cgroup_quota", None),
                ("capacity", None),
                ("source", "unknown"),
                ("cgroup_dir", None),
            ]
        )
    )
    ctx = {
        "pid": args.pid or meta.get("pid"),
        "cmd": args.jstack_file,
        "when": meta.get("timestamp") or "unknown",
        "sampled_at": _iso_from_dump(meta.get("timestamp")),
        "method": method,
        "method_id": method_id,
        "window": window,
        "window_source": wsrc,
        "capacity": capacity,
        "proc": None,
        "ppid": None,
        "process_cpu_pct": None,
        "n_threads": len(rows),
        "n_orphans": len(orphans),
    }
    return rows, orphans, meta, ctx, {"dump": dump, "top": top_raw, "cpu": cpu}


def main(argv=None):
    """Console entry point (also what `pip install` wires the command to)."""
    try:
        return _main(argv)
    except KeyboardInterrupt:
        sys.stderr.write("\ninterrupted\n")
        return 130
    except BrokenPipeError:
        # `| head`, `| jq` exiting early: stop quietly, like other CLI tools.
        # Point stdout at devnull so the interpreter's final flush cannot fail.
        try:
            devnull = os.open(os.devnull, os.O_WRONLY)
            os.dup2(devnull, sys.stdout.fileno())
        except (OSError, ValueError, AttributeError):
            pass
        return 0


def _main(argv=None):
    args = build_parser().parse_args(argv)

    if args.print_schema:
        json.dump(json_schema(), sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0

    setup_encoding(args.ascii)

    if args.json:  # --json still works, -o json is the way
        args.output = "json"
    machine = args.output in ("json", "jsonl")

    if (
        args.no_color
        or machine
        or os.environ.get("NO_COLOR")
        or not sys.stdout.isatty()
    ):
        C.disable()
    else:
        C.apply_theme(args.theme)
    if args.top == 0:
        args.top = None
    if args.delay is not None and args.delay <= 0:
        die("--delay must be > 0")
    if args.cpus is not None and args.cpus <= 0:
        die("--cpus must be > 0")
    if args.count is not None and args.count < 0:
        die("--count must be >= 0")
    if args.interval < 0:
        die("--interval must be >= 0")

    if args.list:
        pids = find_java_pids()
        if not pids:
            print("no JVMs found")
            return 1
        for pid, name in pids:
            print("%7d  %s" % (pid, name))
        return 0

    # ---- offline: always exactly one round --------------------------------
    if args.jstack_file:
        if args.count not in (None, 1) or args.watch:
            warn("--count/--watch need a live JVM; analysing the files once")
        rows, orphans, meta, ctx, raw = collect_offline(args)
        if args.scale == "capacity" and not ctx["capacity"]["capacity"]:
            warn(
                "--scale capacity needs --cpus N for offline files; showing % of one core"
            )
        an = analyse(rows, orphans, meta, ctx)
        hints = investigation_hints(rows, orphans, meta, ctx, an)
        report = build_report(rows, orphans, meta, ctx, an, hints)
        if args.save_dir:
            save_round(args.save_dir, 1, raw, report)
        if machine:
            emit_json(report, compact=args.output == "jsonl")
        else:
            render(rows, orphans, meta, ctx, an, hints, args)
        return 0

    # ---- live --------------------------------------------------------------
    if args.delay is None:
        args.delay = 2.0
    count = args.count if args.count is not None else (0 if args.watch else 1)
    if count == 0 and args.output == "json":
        die(
            "-o json writes one document at the end; for an open-ended run use -o jsonl "
            "(one line per round), or give --count"
        )

    pid = args.pid
    if pid is None:
        pids = find_java_pids()
        if not pids:
            die(
                "no running JVM found; pass --pid, or --jstack-file for offline analysis"
            )
        if len(pids) > 1:
            sys.stderr.write(
                "%sseveral JVMs are running; pick one with --pid:%s\n"
                % (C.YELLOW, C.RESET)
            )
            for p_, name in pids:
                sys.stderr.write("  %7d  %s\n" % (p_, name))
            return 2
        pid = pids[0][0]

    if not pid_alive(pid):
        die("pid %d is not running" % pid)

    method = resolve_method(args)
    capacity = cpu_capacity(pid, override=args.cpus)
    tracker = Tracker(args.hot)
    tracker.started = time.time()
    reports = []
    interrupted = False
    clear = args.watch and not machine and sys.stdout.isatty()
    multi = count != 1

    try:
        while True:
            idx = tracker.rounds + 1
            if idx > 1 and not pid_alive(pid):
                warn("pid %d exited after %d round(s)" % (pid, tracker.rounds))
                break
            rows, orphans, meta, ctx, raw = collect_live(pid, method, args, capacity)
            ctx["round"] = idx
            ctx["rounds_planned"] = count or None
            if multi:
                ctx["round_label"] = "round %d/%s" % (
                    idx,
                    count if count else ("∞" if G.BAR == "█" else "inf"),
                )
            an = analyse(rows, orphans, meta, ctx)
            hints = investigation_hints(rows, orphans, meta, ctx, an)
            tracker.add(rows, orphans, an, hints, pid)
            report = build_report(rows, orphans, meta, ctx, an, hints)
            if args.save_dir:
                save_round(args.save_dir, idx, raw, report)

            if args.output == "jsonl":
                emit_json(report, compact=True)
            elif args.output == "json":
                reports.append(report)
            elif multi and args.summary_only:
                hottest = max(
                    (r for r in rows if r["cpu"] is not None),
                    key=lambda r: r["cpu"],
                    default=None,
                )
                sys.stderr.write(
                    "round %d%s  total %.1f%%  hottest %s\n"
                    % (
                        idx,
                        "/%d" % count if count else "",
                        an["total"],
                        "%s %.1f%%" % (hottest["thread"].name, hottest["cpu"])
                        if hottest
                        else "-",
                    )
                )
            else:
                if clear:
                    sys.stdout.write("\033[H\033[2J")
                render(rows, orphans, meta, ctx, an, hints, args)

            if count and tracker.rounds >= count:
                break
            if args.interval:
                time.sleep(args.interval)
    except KeyboardInterrupt:
        interrupted = True
        if not tracker.rounds:
            raise

    summary = tracker.summary(interrupted) if (multi and tracker.rounds) else None
    if args.save_dir and summary:
        try:
            with open(os.path.join(args.save_dir, "summary.json"), "w") as fh:
                json.dump(summary, fh, indent=2)
        except OSError as e:
            warn("could not save the summary: %s" % e)

    if args.output == "json":
        emit_json(build_series(reports, summary) if multi else reports[0])
    elif args.output == "jsonl":
        if summary:
            emit_json(summary, compact=True)
    elif summary:
        render_summary(summary, args)
    return 130 if interrupted else 0


if __name__ == "__main__":
    sys.exit(main())
